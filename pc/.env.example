# 도커 컴포즈 시크릿 — 실제 .env 는 .gitignore 됨

# ===== 디비 (별도 db-server 사용) =====
# weplay-db-server (Tailscale 100.109.194.86) 의 jjongpal_prd 데이터베이스
DATABASE_URL=postgres://jjongpal:replace-with-password@100.109.194.86:5432/jjongpal_prd

# ===== 인증 =====
JWT_SECRET=replace-with-random-64-chars
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=7776000

# ===== 외부 노출 =====
PUBLIC_BASE_URL=https://jjongpal.uncle-jongpal.com

# ===== 저장 =====
STORAGE_ROOT=/home/weplay/storage/jjongpal

# ===== whisper =====
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=ko
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ===== 파이어베이스 푸시 (FCM) =====
FIREBASE_PROJECT_ID=jjongpal-app
