# 도커 컴포즈 시크릿 — 실제 .env 는 .gitignore 됨

# ===== 디비 =====
POSTGRES_DB=jjongpal
POSTGRES_USER=jjongpal
POSTGRES_PASSWORD=replace-with-random-32-chars
POSTGRES_PORT=127.0.0.1:5432

# ===== 인증 =====
# JWT 서명용 비밀 — 랜덤 64자 이상
JWT_SECRET=replace-with-random-64-chars
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=7776000

# ===== 외부 노출 =====
PUBLIC_BASE_URL=https://samchon.uncle-jongpal.com

# ===== 저장 =====
STORAGE_ROOT=/home/weplay/storage/jjongpal

# ===== 어드민 부트스트랩 =====
# 최초 어드민 생성용. create-user.sh 가 사용.
ADMIN_EMAIL=acosmeticstory@gmail.com
ADMIN_NAME=김정석

# ===== whisper =====
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=ko
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8          # int8 | int8_float16 | float16

# ===== 파이어베이스 푸시 (FCM) =====
# 본인이 콘솔에서 발급한 서비스 계정 키 경로 (./fcm-pusher/service-account.json)
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
