# --- 안드로이드 ---
*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
.kotlin/
app/build/
app/keystore/
app/google-services.json
app/release/

# --- PC 백엔드 ---
pc/.env
pc/postgres/data/
pc/whisper-worker/models/
pc/fcm-pusher/service-account.json
pc/cloudflared/*.json

# --- 로그·캐시 ---
*.log
__pycache__/
*.pyc
.pytest_cache/

# --- 운영 ---
docs/dev-log/*.md
!docs/dev-log/.gitkeep

# --- 임시 ---
*.tmp
*~
*.swp
pc/agent-worker/.venv/
pc/monitor/state.json
pc/watchdog-state/

# 비밀 env 와 그 백업(.env.*, .env.bak-*) 은 저장소에 넣지 않음 · 예시 파일만 허용
**/.env*
!**/.env.example
pc/agent-worker/.env
pc/monitor/.env
# 운영 컨테이너 env (비밀 포함) — 2026-09-30 컨테이너 이름 표준화
pc/.env.*.prd

# 옛 백업 사본(*.bak*)
*.bak
*.bak-*
*.bak.*
*.bak2

# 녹음 저장소(운영 데이터, 2026-10-08 ~/storage/jjongpal 에서 옮김)
/storage/

# 빌드한 설치파일 보관(저장소 제외)
/releases/
